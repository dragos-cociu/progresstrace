#!/bin/sh
set -u
repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd) || exit 0
base=$(git rev-parse ORIG_HEAD 2>/dev/null || git rev-parse HEAD^ 2>/dev/null || true)
head=$(git rev-parse HEAD 2>/dev/null || true)
if [ -z "$base" ] || [ -z "$head" ] || [ "$base" = "$head" ]; then
    exit 0
fi
exec python3 "$repo/.githooks/progresstrace-review.py" --event merge --base "$base" --head "$head"
