{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.progresstrace.dev/stop-assessment-result/1.0.0",
  "title": "ProgressTrace stop assessment result",
  "type": "object",
  "required": ["schemaVersion", "traceId", "algorithm", "terminationEventId", "terminationKind", "declarationSource", "terminationAttested", "terminationRank", "obligationResults", "traceClassification", "stopClassification", "safeStopRank", "traceOverhead"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "traceId": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "algorithm": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "progresstrace-stop-assessor" },
        "version": { "const": "1.0.0" }
      },
      "additionalProperties": false
    },
    "terminationEventId": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "terminationKind": { "$ref": "#/$defs/terminationKind" },
    "declarationSource": { "$ref": "#/$defs/declarationSource" },
    "terminationAttested": { "type": "boolean" },
    "terminationRank": { "type": "integer" },
    "obligationResults": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/obligationResult" }
    },
    "traceClassification": { "$ref": "#/$defs/classification" },
    "stopClassification": {
      "type": "string",
      "enum": ["on-target", "late-termination", "unmet-target-at-termination-present", "incomplete-observation"]
    },
    "safeStopRank": { "type": ["integer", "null"] },
    "traceOverhead": { "type": ["integer", "null"] }
  },
  "additionalProperties": false,
  "$defs": {
    "terminationKind": {
      "type": "string",
      "enum": ["agent-self-reported-stop", "harness-declared-stop", "natural-completion", "external-cancellation", "timeout", "crash-or-error", "capture-truncated", "unknown"]
    },
    "declarationSource": {
      "type": "object",
      "required": ["producerType", "producerName", "producerVersion", "evidenceBasis"],
      "properties": {
        "producerType": { "type": "string", "enum": ["agent", "harness", "operator", "adapter"] },
        "producerName": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "producerVersion": { "type": ["string", "null"], "minLength": 1, "pattern": "\\S" },
        "evidenceBasis": { "type": "string", "enum": ["agent-output", "harness-lifecycle", "operator-annotation", "adapter-inference"] }
      },
      "additionalProperties": false
    },
    "classification": {
      "type": "string",
      "enum": ["progress", "stagnation", "regression", "insufficient-evidence"]
    },
    "obligationResult": {
      "type": "object",
      "required": ["obligationId", "classification", "evidenceEventIds", "outcome", "stableAttainmentRank", "overhead"],
      "properties": {
        "obligationId": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "classification": { "$ref": "#/$defs/classification" },
        "evidenceEventIds": { "type": "array", "items": { "type": "string", "minLength": 1, "pattern": "\\S" } },
        "outcome": { "type": "string", "enum": ["stable-attainment", "unmet-target-at-termination"] },
        "stableAttainmentRank": { "type": ["integer", "null"] },
        "overhead": { "type": ["integer", "null"] }
      },
      "additionalProperties": false
    }
  }
}
