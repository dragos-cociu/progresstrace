{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://progresstrace.local/contracts/shadow-session-summary.schema.json",
  "title": "ShadowSessionSummary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sessionId", "taskContractId", "snapshots", "realDecision", "finalRecommendation", "aligned", "generatedAt", "sourceDigest"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "sessionId": {"type": "string", "minLength": 1},
    "taskContractId": {"type": "string", "minLength": 1},
    "snapshots": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["shadowSequence", "triggeringGateOutcomeId", "advisorySourceDigest", "recommendation", "classification"], "properties": {"shadowSequence": {"type": "integer", "minimum": 0}, "triggeringGateOutcomeId": {"type": "string", "minLength": 1}, "advisorySourceDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "recommendation": {"enum": ["continue", "stop-recommended", "insufficient-evidence"]}, "classification": {"enum": ["progress", "recovery-after-failed-attempt", "repeated-attempt-without-obligation-advancement", "insufficient-evidence"]}}}},
    "realDecision": {"anyOf": [{"$ref": "real-decision-record.schema.json"}, {"type": "null"}]},
    "finalRecommendation": {"enum": ["continue", "stop-recommended", "insufficient-evidence"]},
    "aligned": {"type": ["boolean", "null"]},
    "generatedAt": {"const": "1970-01-01T00:00:00.0000000Z"},
    "sourceDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
