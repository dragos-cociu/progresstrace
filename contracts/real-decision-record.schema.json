{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://progresstrace.local/contracts/real-decision-record.schema.json",
  "title": "RealDecisionRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sessionId", "taskContractId", "decision", "decidedAt", "source"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "sessionId": {"type": "string", "minLength": 1},
    "taskContractId": {"type": "string", "minLength": 1},
    "decision": {"enum": ["continued", "stopped", "merged", "rejected", "escalated", "abandoned", "completed"]},
    "decidedAt": {"type": "string", "format": "date-time"},
    "source": {"type": "string", "minLength": 1}
  }
}
