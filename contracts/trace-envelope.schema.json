{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.progresstrace.dev/trace-envelope/1.0.0",
  "title": "ProgressTrace canonical trace envelope",
  "type": "object",
  "required": [
    "schemaVersion",
    "traceId",
    "source",
    "createdAt",
    "events"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "event": {
      "type": "object",
      "required": [
        "id",
        "sequence",
        "timestamp",
        "type",
        "actor",
        "payload",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "enum": [
            "system",
            "user",
            "assistant",
            "tool",
            "other"
          ]
        },
        "payload": {
          "type": "object",
          "additionalProperties": true
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "sourceEventId"
      ],
      "properties": {
        "sourceEventId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
