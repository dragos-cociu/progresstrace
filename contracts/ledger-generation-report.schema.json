{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://progresstrace.local/contracts/ledger-generation-report.schema.json",
  "title": "LedgerGenerationReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reportType",
    "generator",
    "generatedAt",
    "taskContractId",
    "taskContractPath",
    "taskContractDigest",
    "traceId",
    "ledgerDigest",
    "obligations",
    "unsupportedSourceFields"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "reportType": { "const": "LedgerGenerationReport" },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "progresstrace-ledger-generator" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "generatedAt": { "type": "string", "minLength": 1 },
    "taskContractId": { "type": "string", "minLength": 1 },
    "taskContractPath": { "type": "string", "minLength": 1 },
    "taskContractDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "traceId": { "type": "string", "minLength": 1 },
    "ledgerDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["obligationId", "coverageStatus"],
        "properties": {
          "obligationId": { "type": "string", "minLength": 1 },
          "coverageStatus": { "enum": ["derived-automatic", "manual"] },
          "sourceField": {
            "enum": ["deliverables", "required_contract_decisions", "required_invariants"]
          },
          "sourcePointer": { "type": "string", "minLength": 1 }
        }
      }
    },
    "unsupportedSourceFields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["deliverables", "required_contract_decisions", "required_invariants"]
      }
    }
  }
}
